<PageTitle>@Title | ConnectX</PageTitle>

<section class="dnd-index-page" aria-labelledby="dnd-index-title">
    <nav class="dnd-breadcrumb" aria-label="Breadcrumb">
        <a href="/dnd">D&amp;D</a>
        <span aria-hidden="true">/</span>
        <a href="@HubHref">@HubTitle</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">@Title</span>
    </nav>

    <header class="dnd-index-header">
        <h1 id="dnd-index-title">@Title</h1>
        <p>Coming soon</p>
    </header>
</section>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string HubTitle { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string HubHref { get; set; } = string.Empty;

}
