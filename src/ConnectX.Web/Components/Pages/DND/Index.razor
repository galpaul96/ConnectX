@page "/dnd"

<PageTitle>D&amp;D | ConnectX</PageTitle>

<section class="dnd-hub" aria-labelledby="hub-title">
    <header class="hub-header">
        <h1 id="hub-title">D&amp;D</h1>
    </header>

    <nav class="hub-grid" aria-label="D&amp;D sections">
        <a class="hub-card" href="/dnd/catalogs">
