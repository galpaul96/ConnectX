@if (Spell is not null)
{
    <div class="spell-modal-backdrop" @onclick="CloseAsync">
        <section class="spell-modal-dialog" role="dialog" aria-modal="true"
                 aria-labelledby="spell-modal-title" tabindex="-1"
                 @ref="dialogElement" @onclick:stopPropagation="true" @onkeydown="HandleKeyDown">
            <header class="spell-modal-header">
                <div class="spell-modal-heading">
                    <p class="spell-modal-kicker">@Spell.LevelLabel spell@(string.IsNullOrWhiteSpace(Spell.School) ? string.Empty : $" · {Spell.School}")</p>
                    <h2 id="spell-modal-title">@Spell.Name</h2>
                </div>
                <button type="button" class="spell-modal-close" aria-label="Close spell details" @onclick="CloseAsync">×</button>
            </header>

            <div class="spell-modal-body">
                <SpellImageComponent Spell="Spell" />
                <SpellMetadataGrid Spell="Spell" />
                <SpellCastingTimeNoteComponent Spell="Spell" />
                <SpellDescriptionComponent Spell="Spell" />
                <div class="spell-detail-lists">
                    <SpellTagsComponent Spell="Spell" />
                    <SpellAvailableForComponent Spell="Spell" />
                </div>
            </div>

            <footer class="spell-modal-footer">
                <SpellSourceComponent Spell="Spell" />
                <SpellSourceUrlComponent Spell="Spell" />
            </footer>
        </section>
    </div>
}

@code {
    private ElementReference dialogElement;
    private string? focusedSpellId;

    [Parameter, EditorRequired]
    public SpellCatalogEntry? Spell { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Spell is not null && Spell.Id != focusedSpellId)
        {
            focusedSpellId = Spell.Id;
            await dialogElement.FocusAsync();
        }
    }

    private Task HandleKeyDown(KeyboardEventArgs args) =>
        args.Key == "Escape" ? CloseAsync() : Task.CompletedTask;

    private Task CloseAsync() => OnClose.InvokeAsync();
}
