<dl class="spell-metadata-grid">
    <SpellCastingTimeComponent Component='@Find("castingTime")' />
    <SpellRangeAreaComponent Component='@Find("rangeArea")' />
    <SpellCastingComponentsComponent Component='@Find("components")' />
    <SpellDurationComponent Component='@Find("duration")' />
    <SpellAttackSaveComponent Component='@Find("attackSave")' />
    <SpellDamageEffectComponent Component='@Find("damageEffect")' />
</dl>
@code {
    [Parameter, EditorRequired] public SpellDto Spell { get; set; } = default!;
    private SpellComponentDto? Find(string type) => Spell.Components.FirstOrDefault(x => x.Type == type);
}
