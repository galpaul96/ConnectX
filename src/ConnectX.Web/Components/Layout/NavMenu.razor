@implements IDisposable

@inject NavigationManager NavigationManager

<nav id="primary-nav" class="primary-nav" aria-label="Main navigation">
    <div class="nav-group">
        <span class="nav-group-label">D&amp;D</span>
        <NavLink class="nav-link nav-section-link" href="dnd" Match="NavLinkMatch.All">Overview</NavLink>
        <NavLink class="nav-link nav-section-link" href="dnd/catalogs" Match="NavLinkMatch.All">Catalogs</NavLink>
        <div class="nav-subgroup" aria-label="Catalog shortcuts">
            <NavLink class="nav-link" href="dnd/catalogs/skills" Match="NavLinkMatch.All">Spells</NavLink>
            <NavLink class="nav-link" href="dnd/catalogs/items" Match="NavLinkMatch.All">Items</NavLink>
        </div>
        <NavLink class="nav-link nav-section-link" href="dnd/codex">Codex</NavLink>
    </div>

    <AuthorizeView>
        <Authorized Context="authenticatedContext">
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <div class="nav-group">
                        <span class="nav-group-label">Administration</span>
                        <NavLink class="nav-link" href="admin" Match="NavLinkMatch.All">Users</NavLink>
                        <NavLink class="nav-link" href="admin/roles">Roles</NavLink>
                        <NavLink class="nav-link" href="admin/claims">Claims</NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>

            <div class="nav-bottom">
                <form action="Account/Logout" method="post">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                    <button type="submit" class="nav-link nav-logout">Sign out</button>
                </form>
            </div>
        </Authorized>
    </AuthorizeView>
</nav>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
