@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">Skip to content</a>
<div class="app-shell">
    <aside class="app-sidebar" aria-label="Application navigation">
        <a class="brand-lockup" href="/dnd" aria-label="ConnectX D&amp;D overview">
            <span class="brand-name">Connect<span class="brand-accent">X</span></span>
        </a>
        <button class="sidebar-close" type="button">Close menu</button>
        <NavMenu />
    </aside>

    <button class="sidebar-scrim" type="button" tabindex="-1" aria-label="Close navigation"></button>

    <div class="app-main">
        <header class="topbar">
            <button id="sidebar-toggle" class="menu-toggle" type="button" aria-controls="primary-nav" aria-expanded="false">Menu</button>
            <a class="topbar-home" href="/dnd">D&amp;D</a>
            <div class="topbar-actions">
                <AuthorizeView>
                    <Authorized>
                        <a class="topbar-account" href="Account/Manage">My account</a>
                    </Authorized>
                    <NotAuthorized>
                        <a class="topbar-signin" href="Account/Login">Sign in</a>
                        <a class="topbar-register" href="Account/Register">Create account</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <main id="main-content" class="main-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui">
    Something went wrong. Please refresh the page or try again later.
    <a href="" class="reload">Refresh</a>
    <a class="dismiss">🗙</a>
</div>
