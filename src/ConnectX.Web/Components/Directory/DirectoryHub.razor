<section class="directory-hub" aria-labelledby="directory-hub-title">
    @{ var visibleEntries = FilteredEntries; }

    <header class="directory-hub-header">
        <div class="directory-hub-intro">
            <p class="directory-eyebrow">@Eyebrow</p>
            <h1 id="directory-hub-title">@Title</h1>
            <p class="directory-hub-description">@Description</p>
        </div>

        @if (ShowSearch)
        {
            <div class="directory-search-wrap">
                <label class="visually-hidden" for="directory-search">Search @Title</label>
                <input id="directory-search"
                       class="form-control directory-search"
                       type="search"
                       placeholder="Search @Title"
                       @bind="searchTerm"
                       @bind:event="oninput" />
            </div>
        }
    </header>

    <div class="directory-grid" aria-live="polite">
        @if (visibleEntries.Count > 0)
        {
            @foreach (var entry in visibleEntries)
            {
                <DirectoryCard @key="entry.Href" Entry="entry" />
            }
        }
        else
        {
            <div class="directory-empty-state">
                <span class="directory-empty-mark" aria-hidden="true">⌕</span>
                <h2>No matching sections</h2>
                <p>Try another title or keyword.</p>
            </div>
        }
    </div>

    <p class="directory-count">Showing @visibleEntries.Count of @Entries.Count sections</p>
</section>

@code {
    private string searchTerm = string.Empty;

    [Parameter, EditorRequired]
    public string Eyebrow { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Description { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public IReadOnlyList<DirectoryEntry> Entries { get; set; } = [];

    [Parameter]
    public bool ShowSearch { get; set; } = true;

    private List<DirectoryEntry> FilteredEntries =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? Entries.ToList()
            : Entries.Where(entry =>
                    entry.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    entry.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
}
