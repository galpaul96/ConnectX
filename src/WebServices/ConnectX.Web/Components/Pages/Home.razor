@page "/"

<PageTitle>Home | ConnectX</PageTitle>

<section class="home-hero" aria-labelledby="welcome-title">
    <div class="hero-copy">
        <p class="hero-kicker">Campaign workspace</p>
        <h1 id="welcome-title">Connect<span class="brand-accent">X</span></h1>
        <p class="hero-subtitle">D&amp;D reference and campaign codex</p>
        <div class="hero-rule" aria-hidden="true"></div>
        <p class="hero-description">
            Browse rules and character options in Catalogs, or keep your campaign's characters, people, and quests together in the Codex.
        </p>

        <div class="hero-actions">
            <AuthorizeView>
                <Authorized Context="authenticatedContext">
                    <a class="btn btn-primary btn-lg" href="/catalogs">Explore Catalogs</a>
                    <a class="btn btn-outline-primary btn-lg" href="/codex">Open Codex</a>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-primary btn-lg" href="/catalogs">Explore Catalogs</a>
                    <a class="btn btn-outline-primary btn-lg" href="/codex">Open Codex</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</section>
